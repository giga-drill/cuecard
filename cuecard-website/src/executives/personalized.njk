{% include "partials/footer.njk" %}

<script>
(function() {
    var path = window.location.pathname.replace(/\/+$/, '');
    var parts = path.split('/');
    var slug = parts[2] || '';

    if (!slug || slug === 'personalized') {
        window.location.href = '/executives/';
        return;
    }

    // Convert slug to display name: "firstname-lastname" -> "Firstname Lastname"
    function slugToName(s) {
        return s.split('-').map(function(word) {
            return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
        }).join(' ');
    }

    function buildSubtitle(data) {
        var h = 'Speaker notes <span class="highlight highlight-yellow">visible only to you</span> during screen sharing — for <span class="highlight highlight-green">presentations</span> and <span class="highlight highlight-pink">meetings</span>';
        if (data.company) {
            h += ' at ' + data.company;
        }
        h += '.';
        return h;
    }

    function buildGreeting(data) {
        return 'Hey ' + data.firstname + '! Never run out of time or go off script while presenting.';
    }

    var displayName = slugToName(slug);

    // Remove IDs so script.js doesn't inject counts into buttons
    ['github-stars', 'nav-download-count', 'total-downloads'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.removeAttribute('id');
    });

    // Check via PHP lookup
    fetch('/lookup.php?type=executives&slug=' + encodeURIComponent(slug))
        .then(function(res) {
            if (!res.ok) throw new Error('not found');
            return res.json();
        })
        .then(function(data) {
            document.getElementById('loading-page').style.display = 'none';

            if (data.found) {
                var fullName = data.firstname;
                if (data.lastname) fullName += ' ' + data.lastname;
                document.getElementById('hero-greeting').textContent = buildGreeting(data);
                document.getElementById('hero-subtitle').innerHTML = buildSubtitle(data);
                document.title = 'CueCard for ' + fullName + ' - Invisible Presenter Notes';
            } else {
                document.getElementById('hero-greeting').textContent = 'Nice try, CueCard is still free for everyone.';
                document.getElementById('hero-subtitle').innerHTML = 'This page was made for someone special<br class="desktop-br"> and it\'s not <span class="highlight highlight-pink">' + displayName + '</span>.';
            }

            document.getElementById('main-page').style.display = 'block';
        })
        .catch(function() {
            window.location.href = '/executives/';
        });
})();
</script>
{% endblock %}
